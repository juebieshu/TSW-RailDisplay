<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" Exclude="Assets\Audio\**"/>
        <Content Include="Assets\Audio\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../RailDisplay.Core/RailDisplay.Core.csproj" />
        <ProjectReference Include="../RailDisplay.Infrastructure/RailDisplay.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <ProjectReference Include="../RailDisplay.Debug/RailDisplay.Debug.csproj"
                          ReferenceOutputAssembly="false" OutputItemType="DebugPlugin" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" PrivateAssets="All" />
        <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    </ItemGroup>

    <Target Name="CopyDebugPlugin" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
            Condition="'$(Configuration)' == 'Debug'">
        <ItemGroup>
            <DebugPluginFiles Include="@(DebugPlugin)" />
            <DebugPluginFiles Include="@(DebugPlugin->'%(RootDir)%(Directory)%(Filename).pdb')"
                              Condition="Exists('%(Identity)')" />
        </ItemGroup>
        <Copy SourceFiles="@(DebugPluginFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    </Target>
    <Target Name="PublishDebugPlugin" AfterTargets="Publish" DependsOnTargets="CopyDebugPlugin"
            Condition="'$(Configuration)' == 'Debug'">
        <Copy SourceFiles="@(DebugPluginFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>
