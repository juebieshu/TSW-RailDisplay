<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctcs="using:RailDisplay.Views"
        xmlns:vm="using:RailDisplay.ViewModels"
        x:DataType="vm:MainViewModel"
        x:Class="RailDisplay.Views.MainWindow"
        Title="RailDisplay"
        Width="640"
        Height="480"
        MinWidth="320"
        MinHeight="240"
        TransparencyLevelHint="None"
        Background="Black">

    <ctcs:CTCS2_200H DataContext="{Binding Ctcs}" />

</Window>
